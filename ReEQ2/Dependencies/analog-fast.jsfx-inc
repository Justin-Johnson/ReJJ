 pd=(1-aa2)/(1-aa1+aa2);v=nl_x*nl_iq;pny=nl_dr/sqrt(nl_dr*nl_dr+v*v);
 k=(1-this.nl_lut.v5)/(1+this.nl_lut.v5);rho=(1-this.nl_lut.v4)/(1+this.nl_lut.v4);
 nn=pny*rho/k;u=nn/nl_t2;d=pd*this.nl_lut.v1;shape=0;
