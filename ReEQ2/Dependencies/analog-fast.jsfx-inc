function ef_plot_combine(dl, dh, dm, nl, nh, nm, corr_dl, corr_dh, corr_nl, corr_nh, add_low, add_high)
  instance(num_dc, num_real_mix, num_imag_mix, num_ny,
           den_dc, den_real_mix, den_imag_mix, den_ny)
(
  // After rotating away common phase, a cubic's real and imaginary parts are
  // c*(dc*c^2-real_mix*s^2) and s*(imag_mix*c^2-ny*s^2). c,s are half angles.
  den_dc = dl * corr_dl;
  den_real_mix = dh * corr_dl + dm * corr_dh;
  den_imag_mix = dl * corr_dh + dm * corr_dl;
  den_ny = dh * corr_dh;
  num_dc = nl * corr_nl + dl * add_low;
  num_real_mix = nh * corr_nl + nm * corr_nh + dh * add_low + dm * add_high;
  num_imag_mix = nl * corr_nh + nm * corr_nl + dl * add_high + dm * add_low;
  num_ny = nh * corr_nh + dh * add_high;
);
function ef_plot_coefficients(section*, kind, first)
  local(direct, dc_gain, residual, pole_p, pole_q, cross, det_offset,
        dl, dh, dm, nl, nh, nm, corr_dl, corr_dh, corr_nl, corr_nh, parallel)
(
  direct = section.md;
  dc_gain = kind === 0x0 || kind === 0x5 ? 0x0 : kind === 0x4 ? direct + section.mo0 : 0x1;
  residual = kind === 0x4 ? section.mo0 : dc_gain - direct;

  first ? (
    // Multiply the one-pole numerator and denominator by z for the same basis.
    dl = 0.5 * section.mp;
    dh = 0x1 - dl;
    nl = dc_gain * dl;
    nh = direct - nl;
  ) : (
    cross = section.mr;
    pole_p = section.mp - cross;
    pole_q = section.mq - cross;
    // R^2 = P*Q at designed targets. During a ramp the three terms interpolate
    // independently, so the determinant correction belongs in the frozen plot.
    det_offset = 0.5 * (cross * cross - pole_p * pole_q);
    dl = pole_p + det_offset;
    dh = pole_q + det_offset;
    nl = dc_gain * dl;
    nh = direct * dh + residual * det_offset + section.mo1 * cross;
