 local(r,v,aa1,aa2,pd,pny,u,d,k,rho,shape,nn,nd,iv,irho,invden,offset,root,ir,rny)(
 fc=min(max(fc,.000026041666666666667),.48);q=min(max(q,.25),30);
 (!nl_ready || q!==nl_q)?(nl_q=q;nl_iq=1/q;nl_logq=log(q)*1.4426950408889634074;nl_z=.5*nl_iq;nl_sp=sqrt(abs(nl_z*nl_z-1)););
