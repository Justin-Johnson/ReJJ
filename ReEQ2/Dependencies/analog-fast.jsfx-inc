function fn_encode(side)
 instance(m0,m1,m2,ma1,ma2,c0,c1,ca1,eu,ed,ek,er,ev)
 local(n,u,d,k,rho,nd,cz)(
 n=1-ma1+ma2;u=(1+ma1+ma2)/n;d=(1-ma2)/n;cz=c1/c0;k=(1-cz)/(1+cz);rho=(1-ca1)/(1+ca1);nd=(m0-m2)/n;
 eu=log(u);ed=log(d);ek=log(k);er=rho;ev=side>0?log(2*nd/(u*rho)):0;
);
function fn_notch(bank,tablebase,fc,q)
 instance(nready,nq,nb,nt,du,dd,dk,scale,iq,v0,v1,v2,v3,v4,v5,m0,m1,m2,ma1,ma2,c0,c1,c2,ca1,ca2,used,pv)
 local(delta,r,e,u,d,k,rho,shape,x,dr,ny,nn,nd,phi,iv)(
 (!nready || nq!==q || nb!==bank || nt!==tablebase)?(
  nready=1;nq=q;nb=bank;nt=tablebase;iq=1/q;
  this.left.fq_calc(bank,6,2,.48,q,0);this.left.fn_encode(-1);
  this.anchor.fpb_lookup(tablebase,0,.48,q,0);
