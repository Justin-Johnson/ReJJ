    corr_dh = 0x1 - section.cp;
    corr_nl = corr_dl;
    corr_nh = corr_dh;
  ) : kind === 0x2 ? (
    corr_dl = corr_dh = corr_nl = corr_nh = 0x1;
  ) : (
    corr_dl = corr_nl = section.cp;
    corr_dh = 0x2 - section.cp;
    corr_nh = 0x2 * section.cd - section.cp;
  );

  this.ef_plot_combine(dl, dh, dm, nl, nh, nm, corr_dl, corr_dh, corr_nl, corr_nh,
                       0x0, parallel ? 0x2 * section.nv_k : 0x0);
);
function ef_plot_packed_notch(band*) local(dl, dh, dm, nl, nh, nm, pole_dc, pole_ny) (
  dl = 0.5 * ((0x1 + band.a1) + band.a2);
  dh = 0.5 * ((0x1 - band.a1) + band.a2);
  dm = 0x1 - band.a2;
  nl = band.npB0 * dl + 0.5 * (band.npC0 + band.npC1);
  nh = band.npB0 * dh + 0.5 * (band.npC1 - band.npC0);
  nm = band.npB0 * dm - band.npC1;
  pole_dc = 0x1 + band.cp;
  pole_ny = 0x1 - band.cp;
  this.ef_plot_combine(dl, dh, dm, nl, nh, nm, pole_dc, pole_ny, pole_dc, pole_ny,
                       band.npPv, -band.npPv);
);
function ef_plot_capture(band*, kind, use_target)
  instance(plot_ready, plot_rate, angle_per_hz)
(
  plot_rate = srate;
  plot_ready = plot_rate > 0x0 && kind >= 0x0 && kind <= 0x7 && kind === floor(kind)
               && (kind === 0x6 ? band.ready : band.cold.j9_ready);
