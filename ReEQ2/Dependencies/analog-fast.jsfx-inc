// ReEQ2's analog-matched filter core: fitted sections for every band type.
// ReEQ2's @init allocates the three shared banks (AF_Bank, AF_Notch, AF_Anchor) and fills them once
// with ef_tables_init.
@init
function ri_unpack64(base, offset, data, count) local(i)(
  i=0;loop(count,base[offset+i]=str_getchar(data,i*8,'d');i+=1;);
);
function ri_unpack32(base, offset, data, count) local(i)(
  i=0;loop(count,base[offset+i]=str_getchar(data,i*4,'f');i+=1;);
);

