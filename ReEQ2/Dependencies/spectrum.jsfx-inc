desc: FFT Spectrum Analyzer
/*
  Spectrum Analyzer Library
  
  Reference:
   http://www.zytrax.com/tech/audio/calculator.html
   https://lists.gnu.org/archive/html/help-octave/2015-07/msg00016.html
   http://apmr.matelys.com/Standards/OctaveBands.html
 */

@init

/*
 * Initialise spectrum memory allocater
 * We pass in an existing memory index so that we can integrate with
 * other allocaters
 */
function spectrum.init_memory(i) instance(mem_index) ( 
  mem_index = i;
);

/*
 * Allocate memory for spectrum analyzer
 */
function spectrum.alloc_memory(amount) instance(mem_index) local(i) ( 
  i = mem_index;
  mem_index += amount;
  i;
);

/*
 * Return the memory index so that we can integrate with other allocaters
 */
function spectrum.get_memory_index() instance(mem_index) (
  mem_index;
);

/*
 * Given frequency, return screen x position
 */
function spectrum.freq_to_x(freq) (
  spectrum.left_margin + ((gfx_w - spectrum.left_margin - spectrum.right_margin) * log(freq / spectrum.min_freq) / spectrum.freq_log_max);
);

/*
 * Given screen x position, return frequency
 */
function spectrum.x_to_freq(x) (
  x = spectrum.min_freq * exp(spectrum.freq_log_max * (x - spectrum.left_margin) / (gfx_w - spectrum.left_margin - spectrum.right_margin));
  max(min(x, spectrum.max_freq), spectrum.min_freq);
);

/*
 * Given a magnitude, return y screen position as 0..1 with applied tilt
 */
function spectrum.magnitude_to_01(m, freq) local(db) (
  db = 10 * log10(m);

  // Tilt around 1kHz
  spectrum.tilt != 0.0 ? db += spectrum.tilt * ((log(freq) / log(2)) - (log(1024) / log(2)));

  1.0 - ((db - spectrum.ceiling) / (spectrum.noise_floor - spectrum.ceiling));
);

/*
 * Given a 0..1 screen coordinate, return y screen coordinate
 */
function spectrum.01_to_y(zo) (
  spectrum.top_margin + (1.0 - zo) * (gfx_h - spectrum.top_margin - spectrum.bottom_margin - gfx_texth);
);

/*
 * Put sample in spectrum buffer 0
 */
function spectrum.sample0(s) (
  spectrum.pos0[] = s;
  spectrum.pos0 += 1;
  spectrum.pos0 >= spectrum.end0 ? spectrum.pos0 = spectrum.samples0;
);

/*
 * Put sample in spectrum buffer 1
 */
function spectrum.sample1(s) (
  spectrum.pos1[] = s;
  spectrum.pos1 += 1;
  spectrum.pos1 >= spectrum.end1 ? spectrum.pos1 = spectrum.samples1;
);

/*
 * Put sample in spectrum buffer 2
 */
function spectrum.sample2(s) (
  spectrum.pos2[] = s;
  spectrum.pos2 += 1;
  spectrum.pos2 >= spectrum.end2 ? spectrum.pos2 = spectrum.samples2;
);

/*
 * Put sample in spectrum buffer 3
 */
function spectrum.sample3(s) (
  spectrum.pos3[] = s;
  spectrum.pos3 += 1;
  spectrum.pos3 >= spectrum.end3 ? spectrum.pos3 = spectrum.samples3;
);

/*
 * Put sample in spectrum buffer 4
 */
function spectrum.sample4(s) (
  spectrum.pos4[] = s;
  spectrum.pos4 += 1;
  spectrum.pos4 >= spectrum.end4 ? spectrum.pos4 = spectrum.samples4;
);

/*
 * Put sample in spectrum buffer 5
 */
function spectrum.sample5(s) (
  spectrum.pos5[] = s;
  spectrum.pos5 += 1;
  spectrum.pos5 >= spectrum.end5 ? spectrum.pos5 = spectrum.samples5;
);

/*
 * Put sample in spectrum buffer 6 (ReEQ's ghost spectrum: a dynamic band's detector input)
 */
function spectrum.sample6(s) (
  spectrum.pos6[] = s;
  spectrum.pos6 += 1;
  spectrum.pos6 >= spectrum.end6 ? spectrum.pos6 = spectrum.samples6;
);

/*
 * Start each buffer's writer (spectrum.sample0 to sample6, in @sample) at the start of its history
 */
function spectrum.reset_positions() (
  spectrum.pos0 = spectrum.samples0; spectrum.end0 = spectrum.samples0 + spectrum.histsize;
  spectrum.pos1 = spectrum.samples1; spectrum.end1 = spectrum.samples1 + spectrum.histsize;
  spectrum.pos2 = spectrum.samples2; spectrum.end2 = spectrum.samples2 + spectrum.histsize;
  spectrum.pos3 = spectrum.samples3; spectrum.end3 = spectrum.samples3 + spectrum.histsize;
  spectrum.pos4 = spectrum.samples4; spectrum.end4 = spectrum.samples4 + spectrum.histsize;
  spectrum.pos5 = spectrum.samples5; spectrum.end5 = spectrum.samples5 + spectrum.histsize;
  spectrum.pos6 = spectrum.samples6; spectrum.end6 = spectrum.samples6 + spectrum.histsize;
);

/*
 * Reset all spectrum buffers
 */
function spectrum.reset_buffers() local(i) (
  // Clear sample buffers and force recalculate window
  spectrum.windowsize = 0;
  i = 0;
  loop(7,
    memset(spectrum.buf_samples[i], 0, spectrum.histsize);
    memset(spectrum.buf_y[i], 0, spectrum.max_buffer);
    memset(spectrum.buf_peakmag[i], spectrum.small_mag, spectrum.max_buffer);
    i += 1;
  );
  memset(spectrum.bin_mag, 0, spectrum.max_buffer);
  memset(spectrum.bin_freq, 0, spectrum.max_buffer);
  spectrum.reset_positions();
);

/*
 * Set the new fft block size for all buffers
 */
function spectrum.set_block_size(size) ( 
  spectrum.fftsize = size;

  spectrum.reset_buffers();
);

/*
 * Set the windowing type for all buffers
 */
function spectrum.set_type(t) ( 
  spectrum.windowsize = 0;
  spectrum.windowtype = t;
);

/*
 * Set a spectrum's color
 */
function spectrum.set_color(buf_index, r, g, b, a) ( 
  spectrum.red[buf_index] = r;
  spectrum.green[buf_index] = g;
  spectrum.blue[buf_index] = b;
  spectrum.alpha[buf_index] = a;
);

/*
 * Set whether spectrum peaks are shown
 */
function spectrum.set_show_peaks(show) local(i) (
  spectrum.show_peaks = show;

  // Clear out the peak data (the ghost, buffer 6, has none)
  i = 0;
  loop(6, memset(spectrum.buf_peakmag[i], spectrum.small_mag, spectrum.max_buffer); i += 1);
);

/*
 * Set whether a spectrum is line or filled
 */
function spectrum.set_fill(buf_index, fill) ( 
  spectrum.fill[buf_index] = fill;
);

/*
 * Initialise all variables and allocate buffers
 */
function spectrum.init() local(i) (
  // Main buffer size for all calcs
  spectrum.max_buffer = 16384;

  // Range db
  spectrum.ceiling = 0;
  spectrum.noise_floor = -90;

  // Visible frequency limit
  spectrum.max_freq = 30000;  // Same visible range as ReEQ (MAX_FREQ)
  spectrum.min_freq = 10;
  spectrum.freq_log_max = log(spectrum.max_freq / spectrum.min_freq);

  spectrum.top_margin = 10;
  spectrum.bottom_margin = 0;
  spectrum.left_margin = 0;
  spectrum.right_margin = 0;

  // Tilts around the 1kHz frequency
  spectrum.tilt = 4.5;

  // Piano roll position
  spectrum.piano_y = 50;

  // Smallest magnitude
  spectrum.small_mag = 0.00000000000000000000000001;

  // FFT window
  spectrum.max_fft_size = 32768;
  spectrum.fftsize = 8192;
  spectrum.histsize = spectrum.max_fft_size + (spectrum.max_fft_size * 0.5 - 1);

  spectrum.windowsize = 0;

  spectrum.show_peaks = 0;

  // Window types
  // 1: hamming
  // 2: blackman-harris
  // 3: blackman
  // 4: rectangular
  spectrum.windowtype = 2;  // blackman-harris default
  spectrum.window = spectrum.alloc_memory(spectrum.histsize);

  spectrum.fftworkspace = spectrum.alloc_memory(spectrum.max_fft_size * 0.5 + 1);

  spectrum.default_r = 46 / 255;
  spectrum.default_g = 71 / 255;
  spectrum.default_b = 83 / 255;
  spectrum.default_a = 1;

  spectrum.red = spectrum.alloc_memory(7);
  spectrum.green = spectrum.alloc_memory(7);
  spectrum.blue = spectrum.alloc_memory(7);
  spectrum.alpha = spectrum.alloc_memory(7);

  spectrum.fill = spectrum.alloc_memory(7);

  // Ghost drawing (fill 3): the line's opacity per pixel column, 0..1, set by the caller
  spectrum.ghost_w = spectrum.alloc_memory(16384);

  spectrum.point_x = spectrum.alloc_memory(16384);
  spectrum.point_y = spectrum.alloc_memory(16384);

  // Buffers 0 to 6 (6: the ghost spectrum, drawn as a line whose opacity follows ghost_w). Each keeps its
  // sample history, smoothed columns and peaks; the per-bin work in bin_mag and bin_freq is scratch for
  // whichever is being drawn.
  spectrum.bin_mag = spectrum.alloc_memory(spectrum.max_buffer);
  spectrum.bin_freq = spectrum.alloc_memory(spectrum.max_buffer);
  spectrum.buf_samples = spectrum.alloc_memory(7);
  spectrum.buf_y = spectrum.alloc_memory(7);
  spectrum.buf_peakmag = spectrum.alloc_memory(7);
  i = 0;
  loop(7,
    spectrum.buf_samples[i] = spectrum.alloc_memory(spectrum.histsize);
    spectrum.buf_y[i] = spectrum.alloc_memory(spectrum.max_buffer);
    spectrum.buf_peakmag[i] = spectrum.alloc_memory(spectrum.max_buffer);
    spectrum.set_color(i, spectrum.default_r, spectrum.default_g, spectrum.default_b, spectrum.default_a);
    spectrum.set_fill(i, 1);
    i += 1;
  );
  spectrum.set_color(6, 0.86, 0.89, 0.9, 1);
  spectrum.set_fill(6, 3);
  // The writers in @sample keep plain pointers; ReEQ2 clears the ghost's history and columns
  spectrum.samples0 = spectrum.buf_samples[0];
  spectrum.samples1 = spectrum.buf_samples[1];
  spectrum.samples2 = spectrum.buf_samples[2];
  spectrum.samples3 = spectrum.buf_samples[3];
  spectrum.samples4 = spectrum.buf_samples[4];
  spectrum.samples5 = spectrum.buf_samples[5];
  spectrum.samples6 = spectrum.buf_samples[6];
  spectrum.bin_y6 = spectrum.buf_y[6];
  spectrum.reset_positions();

  spectrum.last_time = spectrum.alloc_memory(7);
);

/*
 * Catmull-Rom through B (t = 0) and C (t = 1), with A and D as the outer points
 */
function spectrum.catmull(A, B, C, D, t) local(t2)
(
  t2 = t * t;
  0.5 * (2 * B + (C - A) * t + (2 * A - 5 * B + 4 * C - D) * t2 + (3 * B - A - 3 * C + D) * t2 * t);
);

/*
 * One box blur pass of radius r over buf (n values), using tmp as scratch
 */
function spectrum.box_pass(buf, tmp, n, r) local(i, sum, w, lo, hi)
(
  sum = 0; i = 0;
  loop(min(r, n), sum += buf[i]; i += 1);
  i = 0;
  loop(n,
    hi = i + r; lo = i - r - 1;
    hi < n ? sum += buf[hi];
    lo >= 0 ? sum -= buf[lo];
    w = min(hi, n - 1) - max(lo + 1, 0) + 1;
    tmp[i] = sum / w;
    i += 1;
  );
  memcpy(buf, tmp, n);
);

function spectrum.draw_line(x1, y1, x2, y2)
(
  x1 = floor(x1);
  x2 = floor(x2);
  x2 = floor(x2);
  y2 = floor(y2);
  
  gfx_line(x1, y1-1, x2, y2-1, 1);
  gfx_line(x1, y1, x2-1,y2-1, 1); 
);

/*
 * Draw the specified spectrum
 */
function spectrum.draw(bufindex)
  local(i, pwr, windowpos, dwindowpos, buf1, buf2, buf3, nb, mag, freq, rate_over_fftsize, ncol, lev, x, x2, v,
        p0, p2, p3, c, c1, sg, r, g, b, a, time, delta, yb, pk, spectrum_fill, bottom, top, span, y, ly, ty, last)
(
  // Select buffer to draw
  spectrum.samples = spectrum.buf_samples[bufindex];
  spectrum.bin_y = spectrum.buf_y[bufindex];
  spectrum.bin_peakmag = spectrum.buf_peakmag[bufindex];
  spectrum.end = spectrum.samples + spectrum.histsize;
  spectrum.pos = bufindex == 0 ? spectrum.pos0 : bufindex == 1 ? spectrum.pos1 : bufindex == 2 ? spectrum.pos2 :
    bufindex == 3 ? spectrum.pos3 : bufindex == 4 ? spectrum.pos4 : bufindex == 5 ? spectrum.pos5 : spectrum.pos6;

  // Create the smoothing spectrum.window if necessary
  spectrum.windowsize != spectrum.fftsize ? (
      spectrum.windowsize = spectrum.fftsize;
      dwindowpos = $pi * 2 / spectrum.fftsize;
      i = pwr = 0;
      loop(spectrum.fftsize*.5+1,
         windowpos = i * dwindowpos;
         pwr += (spectrum.window[i] = (
            // 1: hamming
            spectrum.windowtype==1 ? 0.53836 - cos(windowpos) * 0.46164 :
            // 2: blackman-harris
            spectrum.windowtype==2 ? 0.35875 - 0.48829 * cos(windowpos) + 0.14128 * cos(2 * windowpos) - 0.01168 * cos(3 * windowpos) :
            // 3: blackman
            spectrum.windowtype==3 ? 0.42 - 0.50 * cos(windowpos) + 0.08 * cos(2.0 * windowpos) :
            // 4: rectangular
            1.0));
         i += 1;
      );
      pwr = 0.5 / (pwr * 2 - spectrum.window[i - 1]);
      loop(spectrum.fftsize * 0.5 + 1,spectrum.window[i -= 1] *= pwr);
    );

  // Apply the frequency smoothing spectrum window
  buf1=spectrum.pos - spectrum.fftsize;
  buf1<spectrum.samples ? buf1+=spectrum.histsize;
  buf2=spectrum.window;
  buf3=spectrum.fftworkspace;
  loop(spectrum.fftsize * 0.5 + 1,
    buf3[] = buf1[] * buf2[];
    buf3 += 1;

    buf2 += 1;
    (buf1 += 1) >= spectrum.end ? buf1 = spectrum.samples;
  );
  buf2 -= 1;
  loop(spectrum.fftsize * 0.5 - 1,
    buf3[] = buf1[] * (buf2-=1)[];
    buf3 += 1;

    (buf1 += 1) >= spectrum.end ? buf1 = spectrum.samples;
  );

  fft_real(spectrum.fftworkspace,spectrum.fftsize);
  fft_permute(spectrum.fftworkspace,spectrum.fftsize / 2);
  spectrum.fftworkspace[1] = 0;

  buf3 = spectrum.fftworkspace;

  // Per FFT bin: level (0..1, tilt applied) in bin_mag and screen x in bin_freq. Both are
  // scratch per buffer now; the display works per pixel column from here on.
  nb = spectrum.fftsize * 0.5;
  rate_over_fftsize = srate / spectrum.fftsize;
  i = 1;
  loop(nb - 1,
    mag = sqr(buf3[i*2+0]) + sqr(buf3[i*2+1]);
    freq = i * rate_over_fftsize;
    spectrum.bin_mag[i] = max(spectrum.magnitude_to_01(max(mag, spectrum.small_mag), freq), 0);
    spectrum.bin_freq[i] = spectrum.freq_to_x(freq);
    i += 1;
  );

  // Per pixel column (point_x): the loudest bin in the column where bins are dense, and a
  // smooth curve between bins where they're further apart than a pixel (the low end)
  ncol = min(floor(gfx_w), 16384);
  lev = spectrum.point_x;
  memset(lev, -1, ncol);
  i = 1;
  loop(nb - 1,
    x = spectrum.bin_freq[i]; v = spectrum.bin_mag[i];
    c = floor(x);
    c >= 0 && c < ncol ? lev[c] = max(lev[c], v);
    i < nb - 1 ? (
      x2 = spectrum.bin_freq[i + 1];
      x2 - x > 1 && x2 >= 0 && x < ncol ? (
        p0 = spectrum.bin_mag[max(i - 1, 1)]; p2 = spectrum.bin_mag[i + 1]; p3 = spectrum.bin_mag[min(i + 2, nb - 1)];
        c = max(floor(x) + 1, 0); c1 = min(ceil(x2) - 1, ncol - 1);
        while (c <= c1 ? (
          lev[c] = max(lev[c], min(max(spectrum.catmull(p0, v, p2, p3, (c - x) / (x2 - x)), 0), 1));
          c += 1; 1) : 0);
      );
    );
    i += 1;
  );

  // Columns left of the first bin take its level; anything else unset is the floor
  c = 0; v = -1;
  while (c < ncol && v < 0 ? (v = lev[c]; c += 1; 1) : 0);
  v = max(v, 0);
  c = 0;
  loop(ncol, lev[c] < 0 ? lev[c] = v : v = lev[c]; c += 1);

  // The last bin's column. When the graph reaches past Nyquist the spectrum stops there.
  last = min(floor(spectrum.bin_freq[nb - 1]), ncol - 1);

  // Optional smoothing, in octaves: three box passes approximate a Gaussian
  spectrum.smooth > 0 ? (
    sg = spectrum.smooth * (gfx_w - spectrum.left_margin - spectrum.right_margin) * log(2) / spectrum.freq_log_max;
    r = floor((sqrt(4 * sg * sg + 1) - 1) * 0.5);
    r >= 1 ? loop(3, spectrum.box_pass(lev, spectrum.point_y, ncol, r));
  );

  // Ballistics per column: rise at once, fall back gently. Peak hold keeps the maximum.
  time = time_precise();
  delta = 0.99 ^ ((time - spectrum.last_time[bufindex]) * 30);
  spectrum.last_time[bufindex] = time;

  yb = spectrum.bin_y; pk = spectrum.bin_peakmag;
  c = 0;
  loop(ncol,
    yb[c] = max(lev[c], yb[c] * delta);
    pk[c] = max(pk[c], lev[c]);
    c += 1;
  );

  spectrum_fill = spectrum.fill[bufindex];
  r = spectrum.red[bufindex]; g = spectrum.green[bufindex]; b = spectrum.blue[bufindex]; a = spectrum.alpha[bufindex];

  bottom = gfx_h - spectrum.bottom_margin - gfx_texth;
  top = spectrum.top_margin;

  // Heat (fill 2): a fill under the spectrum line like Fill, each column coloured by its level, from
  // heat_r0/g0/b0 for quiet energy to the spectrum's colour where it's loud, fading towards the floor
  spectrum_fill == 2 ? (
    c = 0;
    loop(last + 1,
      y = floor(min(spectrum.01_to_y(yb[c]), bottom));
      // Heat follows the level in dB over a working range (about -54 to -12 dB, with tilt), not the whole
      // analyser range, so program material reaches the reds well before 0 dB; eased with a smoothstep
      span = min(max((spectrum.noise_floor + yb[c] * (spectrum.ceiling - spectrum.noise_floor) + 54) / 42, 0), 1);
      span = span * span * (3 - 2 * span);
      y < bottom && span > 0.004 ? (
        // Strength rises faster near the top, so loud regions glow without lifting the quiet ones
        ty = min(1, a * (0.25 + 0.75 * span) * (0.85 + 0.45 * span * span));
        gfx_gradrect(c, y, 1, bottom - y,
          spectrum.heat_r0 + (r - spectrum.heat_r0) * span,
          spectrum.heat_g0 + (g - spectrum.heat_g0) * span,
          spectrum.heat_b0 + (b - spectrum.heat_b0) * span,
          ty, 0, 0, 0, 0, 0, 0, 0, -0.9 * ty / max(bottom - y, 1));
      );
      c += 1;
    );
  ) :
  // Fill: a vertical fade per column, anchored to the graph so loud regions read brighter
  spectrum_fill == 1 ? (
    span = max(bottom - top, 1);
    c = 0;
    loop(last + 1,
      y = floor(min(spectrum.01_to_y(yb[c]), bottom));
      y < bottom ? gfx_gradrect(c, y, 1, bottom - y, r, g, b, a * (0.07 + 0.93 * (bottom - y) / span), 0, 0, 0, 0, 0, 0, 0, -0.93 * a / span);
      c += 1;
    );
  );

  // Ghost (fill 3): each column's fill and line as opaque as ghost_w says, and no peaks. The fill is in
  // the style of the main display (ghost_style: 0 Fill, 1 Line, 2 Heat), in the ghost's own colour, and
  // shows only where ghost_w is above 0.25 (the caller's range and its short fade).
  spectrum_fill == 3 ? (
    span = max(bottom - top, 1);
    c = 0;
    spectrum.ghost_style != 1 ? loop(last + 1,
      v = (spectrum.ghost_w[c] - 0.25) / 0.75;
      y = floor(min(spectrum.01_to_y(yb[c]), bottom));
      v > 0.01 && y < bottom ? (
        spectrum.ghost_style == 2 ? (
          // As Heat: strength from the level over its working range, fading towards the floor
          sg = min(max((spectrum.noise_floor + yb[c] * (spectrum.ceiling - spectrum.noise_floor) + 54) / 42, 0), 1);
          sg = sg * sg * (3 - 2 * sg);
          ty = min(1, a * (0.25 + 0.75 * sg) * (0.85 + 0.45 * sg * sg)) * 0.6 * v;
          gfx_gradrect(c, y, 1, bottom - y, r, g, b, ty, 0, 0, 0, 0, 0, 0, 0, -0.9 * ty / max(bottom - y, 1));
        ) : (
          // As Fill: a vertical fade anchored to the graph, so louder reads brighter
          ty = a * 0.5 * v;
          gfx_gradrect(c, y, 1, bottom - y, r, g, b, ty * (0.07 + 0.93 * (bottom - y) / span), 0, 0, 0, 0, 0, 0, 0, -0.93 * ty / span);
        );
      );
      c += 1;
    );
    gfx_r = r; gfx_g = g; gfx_b = b;
    ly = min(spectrum.01_to_y(yb[0]), bottom);
    c = 1;
    loop(last,
      ty = min(spectrum.01_to_y(yb[c]), bottom);
      gfx_a = a * spectrum.ghost_w[c];
      gfx_a > 0.01 && (ly < bottom - 1 || ty < bottom - 1) ? spectrum.draw_line(c - 1, ly, c, ty);
      ly = ty;
      c += 1;
    );
  ) : (

  // Line: a thin, faint tint over a heat map, a pale tint of the fill colour over a filled spectrum,
  // or the colour itself
  spectrum_fill == 2 ? (
    gfx_r = r + (1 - r) * 0.35; gfx_g = g + (1 - g) * 0.35; gfx_b = b + (1 - b) * 0.35; gfx_a = 0.5;
  ) : spectrum_fill ? (
    gfx_r = r + (1 - r) * 0.45; gfx_g = g + (1 - g) * 0.45; gfx_b = b + (1 - b) * 0.45; gfx_a = 0.7;
  ) : (
    gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a;
  );
  ly = min(spectrum.01_to_y(yb[0]), bottom);
  c = 1;
  loop(last,
    ty = min(spectrum.01_to_y(yb[c]), bottom);
    ly < bottom - 1 || ty < bottom - 1 ? spectrum.draw_line(c - 1, ly, c, ty);
    ly = ty;
    c += 1;
  );
  // Ending at Nyquist, inside the graph: drop to the floor rather than stop in mid air
  last < ncol - 1 && ly < bottom - 1 ? spectrum.draw_line(last, ly, last, bottom);

  spectrum.show_peaks ? (
    gfx_r = gfx_g = gfx_b = 0.8; gfx_a = 0.35;
    ly = min(spectrum.01_to_y(pk[0]), bottom);
    c = 1;
    loop(last,
      ty = min(spectrum.01_to_y(pk[c]), bottom);
      ly < bottom || ty < bottom ? spectrum.draw_line(c - 1, ly, c, ty);
      ly = ty;
      c += 1;
    );
    last < ncol - 1 && ly < bottom ? spectrum.draw_line(last, ly, last, bottom);
  );
  );

);
