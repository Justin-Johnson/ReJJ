import Dependencies/spectrum.jsfx-inc
import Dependencies/ivantsov_filter.jsfx-inc

in_pin:left input
in_pin:right input
in_pin:sc input left
in_pin:sc input right
in_pin:sc 2 input left
in_pin:sc 2 input right
in_pin:sc 3 input left
in_pin:sc 3 input right
out_pin:left output
out_pin:right output

options:no_meter

@init

// This should be the same as in the comment header
#VERSION = "1.2.0";

gfx_ext_retina  = 1;

// Embedded in the TCP/MCP, draw without REAPER's decoration (REAPER 7.45+, set in @init)
gfx_ext_flags |= 0x100;
ext_nodenorm    = 1;
ext_noinit = 1;
last_gfx_ext_retina = -1;

/*
 * Initialise memory allocator
 */
function init_memory() instance(index) ( 
  index = 0;
);

/*
 * Allocate memory
 */
function alloc_memory(amount) instance(index) local(i) ( 
  i = index;
  index += amount;
  i;
);

/*
 * Round number up or down
 */
function round(in) (
  floor(in + 0.5 * sign(in));
);

/*
 * Standard log2
 */
function log2(x) ( 
  log(x) / log(2);
);

/*
 * Return string of integer
 */
function int2str(intIn) local (outStr) (
  strcpy(outStr=#,"");
  sprintf(outStr,"%d",intIn);
  outStr;
);

/*
 * Get note from frequency
 */
function freq2note(f) (
  round(12*(log(f/440)/log(2))+69);
);

/*
 * Get gain (for filters) from dB
 */
function db_to_gain(db) ( 
    10^(db / 40);
);

/*
 * Color object
 */
function create_color(r, g, b)
  instance(red, green, blue) (
  red = r / 255;
  green = g / 255;
  blue = b / 255;
);

/*
 * Update the state of any changes
 */
function update_state() local (dm, blocks, fade, fill_r, fill_g, fill_b, fill_a, line_r, line_g, line_b, line_a) (
  spectrum.ceiling = Ceiling_Value == 0 ? 0 : Ceiling_Value == 1 ? 20 : Ceiling_Value == 2 ? 40;
  spectrum.noise_floor = Floor_Value == 0 ? -90 : Floor_Value == 1 ? -140 : Floor_Value == 2 ? -200;
  spectrum.noise_floor = Floor_Value == 0 ? -90 : Floor_Value == 1 ? -140 : Floor_Value == 2 ? -200;
  spectrum.tilt = Tilt_Value == 0 ? 0 : Tilt_Value == 1 ? 1.5 : Tilt_Value == 2 ? 3 : Tilt_Value == 3 ? 4.5 :
                  Tilt_Value == 4 ? 6;

  spectrum.windowtype != Type_Value+1 ? spectrum.set_type(Type_Value+1);

  blocks = (2 ^ (Block_Value+1)) * 1024;

  spectrum.smooth = Smoothing_Value == 1 ? 1/48 : Smoothing_Value == 2 ? 1/24 : Smoothing_Value == 3 ? 1/12 : Smoothing_Value == 4 ? 1/6 : 0;

  spectrum.windowsize != blocks ? spectrum.set_block_size(blocks);

  fade = do_listen ? 0.5 : 1.0;

  // Listen spectrum colours
  listline_r = (240 / 255) * 0.80;
  listline_g = (101 / 255) * 0.80;
  listline_b = (76 / 255) * 0.80;

  // The spectrum mode the analyser feeds and draws
  SPEC_MODE = Spectrum_Mode;
  dm = Display_Mode;

  dm == 0 ? (
    // Light fills: Mid or Left in cool slate, Side or Right in warm sand (the fill fades
    // down from the top of the graph; the spectrum draws a paler line along its edge)
    fill_r = 93 / 255;
    fill_g = 138 / 255;
    fill_b = 160 / 255;
    fill_a = 0.35;
    spectrum.set_fill(0, 1);
    spectrum.set_color(0, fill_r*fade, fill_g*fade, fill_b*fade, fill_a);

    // Pre-EQ: dim grey lines
    spectrum.set_fill(2, 0);
    spectrum.set_color(2, 138 / 255, 148 / 255, 153 / 255, 0.5);

    fill_r = 176 / 255;
    fill_g = 150 / 255;
    fill_b = 110 / 255;
    fill_a = 0.28;
    spectrum.set_fill(1, 1); 
    spectrum.set_color(1, fill_r*fade, fill_g*fade, fill_b*fade, fill_a);

    spectrum.set_fill(3, 0);
    spectrum.set_color(3, 138 / 255, 148 / 255, 153 / 255, 0.4);

    spectrum.set_fill(4, 0);
    spectrum.set_color(4, listline_r, listline_g, listline_b, 1);

    spectrum.set_fill(5, 0);
    spectrum.set_color(5, listline_r*0.80, listline_g*0.80, listline_b*0.80, 1);

  ) : dm == 3 ? (
    // Heat: Mid or Left as a fill coloured by level, deep plum for quiet energy rising to a soft red
    // where it's loud; Side or Right as a sand line over a faint sand fill, as in Fill
    spectrum.heat_r0 = 92 / 255 * fade; spectrum.heat_g0 = 52 / 255 * fade; spectrum.heat_b0 = 86 / 255 * fade;
    spectrum.set_fill(0, 2);
    spectrum.set_color(0, 240 / 255 * fade, 86 / 255 * fade, 98 / 255 * fade, 0.85);

    spectrum.set_fill(1, 1);
    spectrum.set_color(1, 176 / 255 * fade, 150 / 255 * fade, 110 / 255 * fade, 0.12);

    spectrum.set_fill(2, 0);
    spectrum.set_color(2, 138 / 255, 148 / 255, 153 / 255, 0.5);

    spectrum.set_fill(3, 0);
    spectrum.set_color(3, 138 / 255, 148 / 255, 153 / 255, 0.4);

    spectrum.set_fill(4, 0);
    spectrum.set_color(4, listline_r, listline_g, listline_b, 1);

    spectrum.set_fill(5, 0);
    spectrum.set_color(5, listline_r*0.80, listline_g*0.80, listline_b*0.80, 1);

  ) : dm == 1 ? (
    line_a=1.0;
    line_r = 114 / 255; line_g = 215 / 255; line_b = 253 / 255;;
    spectrum.set_fill(0, 0);
    spectrum.set_color(0, line_r*fade, line_g*fade, line_b*fade, line_a);
    
    spectrum.set_fill(2, 0);
    spectrum.set_color(2, 138 / 255, 148 / 255, 153 / 255, 0.5);

    line_r = 253 / 255; line_g = 185 / 255; line_b = 21 / 255;;
    spectrum.set_fill(1, 0);
    spectrum.set_color(1, line_r*fade, line_g*fade, line_b*fade, line_a);

    spectrum.set_fill(3, 0);
    spectrum.set_color(3, 138 / 255, 148 / 255, 153 / 255, 0.4);

    spectrum.set_fill(4, 0);
    spectrum.set_color(4, listline_r, listline_g, listline_b, 1);

    spectrum.set_fill(5, 0);
    spectrum.set_color(5, listline_r*0.80, listline_g*0.80, listline_b*0.80, 1);
  );

  Db_Range == 0 ? (DB_EQ_RANGE = 6; DB_EQ_RANGE_STEPS = 1;) : 
    Db_Range == 1 ? (DB_EQ_RANGE = 12; DB_EQ_RANGE_STEPS = 3;) :
      Db_Range == 2 ? (DB_EQ_RANGE = 18; DB_EQ_RANGE_STEPS = 6;) :
        Db_Range == 3 ? (DB_EQ_RANGE = 24; DB_EQ_RANGE_STEPS = 8;) :
          Db_Range == 4 ? (DB_EQ_RANGE = 30; DB_EQ_RANGE_STEPS = 10;);

  // spectrum.reset_buffers();
);

/*
 * Notify Reaper that frequency has been touched
 */
function notify_touched_frequency(node) (
  // Notify Reaper that a parameter change has happened
  node == 0 ? slider_automate(Node1_Frequency) :
    node == 1 ? slider_automate(Node2_Frequency) :
      node == 2 ? slider_automate(Node3_Frequency) :
        node == 3 ? slider_automate(Node4_Frequency) :
          node == 4 ? slider_automate(Node5_Frequency) :
            node == 5 ? slider_automate(Node6_Frequency) :
              node == 6 ? slider_automate(Node7_Frequency) :
                node == 7 ? slider_automate(Node8_Frequency) :
                  node == 8 ? slider_automate(Node9_Frequency) :
                    node == 9 ? slider_automate(Node10_Frequency) :
                      node == 10 ? slider_automate(Node11_Frequency) :
                        node == 11 ? slider_automate(Node12_Frequency) :
                          node == 12 ? slider_automate(Node13_Frequency) :
                            node == 13 ? slider_automate(Node14_Frequency) :
                              node == 14 ? slider_automate(Node15_Frequency) :
                                node == 15 ? slider_automate(Node16_Frequency);
);

/*
 * Notify Reaper that gain has been touched
 */
function notify_touched_gain(node) (
  // Notify Reaper that a parameter change has happened
  node == 0 ? slider_automate(Node1_Gain) :
    node == 1 ? slider_automate(Node2_Gain) :
      node == 2 ? slider_automate(Node3_Gain) :
        node == 3 ? slider_automate(Node4_Gain) :
          node == 4 ? slider_automate(Node5_Gain) :
            node == 5 ? slider_automate(Node6_Gain) :
              node == 6 ? slider_automate(Node7_Gain) :
                node == 7 ? slider_automate(Node8_Gain) :
                  node == 8 ? slider_automate(Node9_Gain) :
                    node == 9 ? slider_automate(Node10_Gain) :
                      node == 10 ? slider_automate(Node11_Gain) :
                        node == 11 ? slider_automate(Node12_Gain) :
                          node == 12 ? slider_automate(Node13_Gain) :
                            node == 13 ? slider_automate(Node14_Gain) :
                              node == 14 ? slider_automate(Node15_Gain) :
                                node == 15 ? slider_automate(Node16_Gain);
);

/*
 * Notify Reaper that Q has been touched
 */
function notify_touched_Q(node) (
  // Notify Reaper that a parameter change has happened
  node == 0 ? slider_automate(Node1_Q) :
    node == 1 ? slider_automate(Node2_Q) :
      node == 2 ? slider_automate(Node3_Q) :
        node == 3 ? slider_automate(Node4_Q) :
          node == 4 ? slider_automate(Node5_Q) :
            node == 5 ? slider_automate(Node6_Q) :
              node == 6 ? slider_automate(Node7_Q) :
                node == 7 ? slider_automate(Node8_Q) :
                  node == 8 ? slider_automate(Node9_Q) :
                    node == 9 ? slider_automate(Node10_Q) :
                      node == 10 ? slider_automate(Node11_Q) :
                        node == 11 ? slider_automate(Node12_Q) :
                          node == 12 ? slider_automate(Node13_Q) :
                            node == 13 ? slider_automate(Node14_Q) :
                              node == 14 ? slider_automate(Node15_Q) :
                                node == 15 ? slider_automate(Node16_Q);
);

/*
 * Notify REAPER that a dynamics setting changed: p is 0 on, 1 threshold, 2 ratio, 3 range, 4 attack,
 * 5 release
 */
function notify_touched_dyn(node, p) (
  p == 0 ? (node == 0 ? slider_automate(Node1_DynOn) : node == 1 ? slider_automate(Node2_DynOn) : node == 2 ? slider_automate(Node3_DynOn) : node == 3 ? slider_automate(Node4_DynOn) : node == 4 ? slider_automate(Node5_DynOn) : node == 5 ? slider_automate(Node6_DynOn) : node == 6 ? slider_automate(Node7_DynOn) : node == 7 ? slider_automate(Node8_DynOn) : node == 8 ? slider_automate(Node9_DynOn) : node == 9 ? slider_automate(Node10_DynOn) : node == 10 ? slider_automate(Node11_DynOn) : node == 11 ? slider_automate(Node12_DynOn) : node == 12 ? slider_automate(Node13_DynOn) : node == 13 ? slider_automate(Node14_DynOn) : node == 14 ? slider_automate(Node15_DynOn) : slider_automate(Node16_DynOn)) :
  p == 1 ? (node == 0 ? slider_automate(Node1_DynThresh) : node == 1 ? slider_automate(Node2_DynThresh) : node == 2 ? slider_automate(Node3_DynThresh) : node == 3 ? slider_automate(Node4_DynThresh) : node == 4 ? slider_automate(Node5_DynThresh) : node == 5 ? slider_automate(Node6_DynThresh) : node == 6 ? slider_automate(Node7_DynThresh) : node == 7 ? slider_automate(Node8_DynThresh) : node == 8 ? slider_automate(Node9_DynThresh) : node == 9 ? slider_automate(Node10_DynThresh) : node == 10 ? slider_automate(Node11_DynThresh) : node == 11 ? slider_automate(Node12_DynThresh) : node == 12 ? slider_automate(Node13_DynThresh) : node == 13 ? slider_automate(Node14_DynThresh) : node == 14 ? slider_automate(Node15_DynThresh) : slider_automate(Node16_DynThresh)) :
  p == 2 ? (node == 0 ? slider_automate(Node1_DynRatio) : node == 1 ? slider_automate(Node2_DynRatio) : node == 2 ? slider_automate(Node3_DynRatio) : node == 3 ? slider_automate(Node4_DynRatio) : node == 4 ? slider_automate(Node5_DynRatio) : node == 5 ? slider_automate(Node6_DynRatio) : node == 6 ? slider_automate(Node7_DynRatio) : node == 7 ? slider_automate(Node8_DynRatio) : node == 8 ? slider_automate(Node9_DynRatio) : node == 9 ? slider_automate(Node10_DynRatio) : node == 10 ? slider_automate(Node11_DynRatio) : node == 11 ? slider_automate(Node12_DynRatio) : node == 12 ? slider_automate(Node13_DynRatio) : node == 13 ? slider_automate(Node14_DynRatio) : node == 14 ? slider_automate(Node15_DynRatio) : slider_automate(Node16_DynRatio)) :
  p == 3 ? (node == 0 ? slider_automate(Node1_DynRange) : node == 1 ? slider_automate(Node2_DynRange) : node == 2 ? slider_automate(Node3_DynRange) : node == 3 ? slider_automate(Node4_DynRange) : node == 4 ? slider_automate(Node5_DynRange) : node == 5 ? slider_automate(Node6_DynRange) : node == 6 ? slider_automate(Node7_DynRange) : node == 7 ? slider_automate(Node8_DynRange) : node == 8 ? slider_automate(Node9_DynRange) : node == 9 ? slider_automate(Node10_DynRange) : node == 10 ? slider_automate(Node11_DynRange) : node == 11 ? slider_automate(Node12_DynRange) : node == 12 ? slider_automate(Node13_DynRange) : node == 13 ? slider_automate(Node14_DynRange) : node == 14 ? slider_automate(Node15_DynRange) : slider_automate(Node16_DynRange)) :
  p == 4 ? (node == 0 ? slider_automate(Node1_DynAttack) : node == 1 ? slider_automate(Node2_DynAttack) : node == 2 ? slider_automate(Node3_DynAttack) : node == 3 ? slider_automate(Node4_DynAttack) : node == 4 ? slider_automate(Node5_DynAttack) : node == 5 ? slider_automate(Node6_DynAttack) : node == 6 ? slider_automate(Node7_DynAttack) : node == 7 ? slider_automate(Node8_DynAttack) : node == 8 ? slider_automate(Node9_DynAttack) : node == 9 ? slider_automate(Node10_DynAttack) : node == 10 ? slider_automate(Node11_DynAttack) : node == 11 ? slider_automate(Node12_DynAttack) : node == 12 ? slider_automate(Node13_DynAttack) : node == 13 ? slider_automate(Node14_DynAttack) : node == 14 ? slider_automate(Node15_DynAttack) : slider_automate(Node16_DynAttack)) :
  p == 5 ? (node == 0 ? slider_automate(Node1_DynRelease) : node == 1 ? slider_automate(Node2_DynRelease) : node == 2 ? slider_automate(Node3_DynRelease) : node == 3 ? slider_automate(Node4_DynRelease) : node == 4 ? slider_automate(Node5_DynRelease) : node == 5 ? slider_automate(Node6_DynRelease) : node == 6 ? slider_automate(Node7_DynRelease) : node == 7 ? slider_automate(Node8_DynRelease) : node == 8 ? slider_automate(Node9_DynRelease) : node == 9 ? slider_automate(Node10_DynRelease) : node == 10 ? slider_automate(Node11_DynRelease) : node == 11 ? slider_automate(Node12_DynRelease) : node == 12 ? slider_automate(Node13_DynRelease) : node == 13 ? slider_automate(Node14_DynRelease) : node == 14 ? slider_automate(Node15_DynRelease) : slider_automate(Node16_DynRelease));
);

/*
 * Tell REAPER (undo, project modified) about a dynamics change that has no slider of its own: timing or
 * source. The band's DYN slider stands in for it.
 */
function notify_dyn_state(node) (
  node == 0 ? sliderchange(Node1_DynOn) : node == 1 ? sliderchange(Node2_DynOn) : node == 2 ? sliderchange(Node3_DynOn) : node == 3 ? sliderchange(Node4_DynOn) : node == 4 ? sliderchange(Node5_DynOn) : node == 5 ? sliderchange(Node6_DynOn) : node == 6 ? sliderchange(Node7_DynOn) : node == 7 ? sliderchange(Node8_DynOn) : node == 8 ? sliderchange(Node9_DynOn) : node == 9 ? sliderchange(Node10_DynOn) : node == 10 ? sliderchange(Node11_DynOn) : node == 11 ? sliderchange(Node12_DynOn) : node == 12 ? sliderchange(Node13_DynOn) : node == 13 ? sliderchange(Node14_DynOn) : node == 14 ? sliderchange(Node15_DynOn) : sliderchange(Node16_DynOn);
);

function band_init()
  instance (enabled, type, frequency, gain, q, filter, color, det, dlive) (
  filter.ivf_init(srate);
  det.ivf_init(srate);
  // A dynamic band sets its section up again from scratch
  dlive = 0;
  color.create_color(0,0,0);
);

/*
 * Set enabled state for a band
 */
function band_set_enabled(e)
  instance (enabled, type, frequency, gain, q, filter, color) ( 
  enabled = e;
);

/*
 * Set the filter
 */
function band_set_filter(t, f, g, qval, slope)
  instance (enabled, type, frequency, gain, q, filter, color) (
  type = t; frequency = f; gain = g; q = qval;
  type == 0 ? filter.ivf_bell(frequency, q, gain) :
    type == 1 ? filter.ivf_low_cut(frequency, q, slope) :
      type == 2 ? filter.ivf_low_cut_bw(frequency, slope) :
        type == 3 ? filter.ivf_low_shelf(frequency, q, gain) :
          type == 4 ? filter.ivf_high_shelf(frequency, q, gain) :
            type == 5 ? filter.ivf_high_cut(frequency, q, slope) :
              type == 6 ? filter.ivf_high_cut_bw(frequency, slope) :
                type == 7 ? filter.ivf_notch(frequency, q) :
                  type == 8 ? filter.ivf_band_pass(frequency, q) :
                    type == 9 ? filter.ivf_tilt(frequency, q, gain) :
                      type == 10 ? filter.ivf_pultec_low(frequency, q, gain) :
                        type == 11 ? filter.ivf_all_pass(frequency, q) :
                          type == 12 ? filter.ivf_vintage_low(frequency, q, gain) :
                            type == 13 ? filter.ivf_vintage_high(frequency, q, gain);
);

/*
 * Dynamics, per band (band b, in the band's namespace with its filter).
 *
 * A dynamic band always runs its one section, at its static gain plus the dynamic change (both scaled
 * by Scale). Its detector hears ReEQ's input after the IN trim (or a sidechain pair) in the band's
 * placement, through its own filter: a band-pass at the band's frequency and Q for a bell, a low or
 * high pass at a shelf's frequency. The level is RMS-style, over about a cycle. Every DYN_STEP samples
 * the gain computer (soft knee, ratio, range) gives the change it wants, attack and release move the
 * change towards it, and when it has moved the section glides to it over the next DYN_STEP samples.
 */
function band_dyn_section(t, f, qval, db)
  instance (filter) (
  filter.s1.ivf_sec_calc(t == FILTER_LOW_SHELF ? 4 : t == FILTER_HIGH_SHELF ? 3 : 7, f, 0.5 / qval, 10^(db / 40));
);

/*
 * A dynamic band's detector design, into this filter. Linked to the band: a band-pass at its frequency
 * and Q for a bell, a low or high pass at a shelf's frequency. Unlinked: 24dB/oct Butterworth high and
 * low passes either side of the detector frequency, Band_Dyn_DetWidth octaves apart, with the centre
 * brought back to 0dB (so a narrow pair is a band-pass). Returns that centre gain (1 when linked).
 */
/*
 * An unlinked detector's frequency (20Hz to 20kHz, below Nyquist) and width (0.25 to 8 octaves), clamped
 * whatever was loaded or dragged
 */
function dyn_det_freq_u(b) (
  min(max(Band_Dyn_DetFreq[b], 20), min(20000, 0.45 * srate));
);

function dyn_det_width(b) (
  min(max(Band_Dyn_DetWidth[b], 0.25), 8);
);

function dyn_det_put(b) local (t, f, w, fl, fh, n, m) (
  t = Band_Type[b];
  Band_Dyn_Link[b] ? (
    f = Band_Frequency[b];
    t == FILTER_LOW_SHELF ? this.ivf_put(1, 1, f, 0.7071, 1) :
      t == FILTER_HIGH_SHELF ? this.ivf_put(1, 0, f, 0.7071, 1) :
        this.ivf_put(1, 5, f, 0.5 / Band_Q[b], 1);
    this.ivf_commit(1, 0);
    this.ivf_set_to_target();
    1;
  ) : (
    f = dyn_det_freq_u(b); w = dyn_det_width(b);
    fl = max(f * 2 ^ (-0.5 * w), 10); fh = min(f * 2 ^ (0.5 * w), 0.45 * srate);
    fh < fl * 1.05 ? (fl = fh / 1.05);
    n = this.ivf_put_butterworth(1, 0, fl, 4);
    n = this.ivf_put_butterworth(n, 1, fh, 4);
    this.ivf_commit(n - 1, 0);
    this.ivf_set_to_target();
    // 0dB where the pair peaks, between its corners (the response the audio actually gets)
    m = this.ivf_magnitude(sqrt(fl * fh));
    1 / max(m, 0.05);
  );
);

/*
 * The detector's lowest frequency of interest (for the RMS time), and its frequency and Q for Auto timing
 */
function dyn_det_low(b) (
  Band_Dyn_Link[b] ? Band_Frequency[b] : max(dyn_det_freq_u(b) * 2 ^ (-0.5 * dyn_det_width(b)), 10);
);

function dyn_det_freq(b) (
  Band_Dyn_Link[b] ? Band_Frequency[b] : dyn_det_freq_u(b);
);

function dyn_det_q(b) (
  Band_Dyn_Link[b] ? Band_Q[b] : 1.41 / dyn_det_width(b);
);

/*
 * A dynamic band's settings changed (or it just became dynamic). New frequency, Q, gain and Scale become
 * targets that the tick glides to, so automating them never holds the dynamics up. Only when the band
 * has just become dynamic, or its shape changed, does the section glide in the normal way (30ms),
 * holding the dynamics for that long. The detector follows straight away.
 */
function band_dyn_set_filter(b, scal)
  instance (filter, det, dgap, dkrms, dstatic_glide, dlive, dtype, dsf, dsq, dsg, dss, dtf, dtq, dtg, dts,
            dsmooth, dnorm, dlink) local (t, f) (
  t = Band_Type[b];
  dtf = Band_Frequency[b]; dtq = Band_Q[b]; dtg = Band_Gain[b]; dts = scal;
  !dlive || t != dtype ? (
    dtype = t;
    dsf = dtf; dsq = dtq; dsg = dtg; dss = dts;
    this.band_dyn_section(t, dsf, dsq, (dsg + dgap) * dss);
    filter.ivf_set_sample_rate(srate);
    filter.ivf_commit(1, 0);
    dstatic_glide = 1;
    dlive = 1;
    // The detector's kind may have changed too: start it clean
    det.ivf_reset();
  );
  // Linking or unlinking changes the detector's kind as well
  dlink != Band_Dyn_Link[b] ? (dlink = Band_Dyn_Link[b]; det.ivf_reset());
  // Static changes glide with a 10ms time constant, stepped every DYN_STEP samples
  dsmooth = 1 - exp(-DYN_STEP / (0.01 * srate));

  // The detector: its own filter, linked to the band or at the detector node
  dnorm = det.dyn_det_put(b);

  // RMS over about a cycle of the detector's lowest frequency (at least 1ms)
  f = dyn_det_low(b);
  dkrms = 1 - exp(-1 / (max(1 / f, 0.001) * srate));
);

/*
 * Auto timing: the attack from the detector's frequency and Q (about 1.5 cycles, plus the detector's
 * settling time Q / (pi f), plus 0.5ms), and the fast release from the attack, in ms
 */
function band_dyn_auto_attack(b) local (f) (
  f = dyn_det_freq(b);
  min(max(1000 * (1.5 / f + dyn_det_q(b) / ($pi * f)) + 0.5, 0.5), 30);
);

function band_dyn_auto_release(b) (
  min(max(8 * band_dyn_auto_attack(b), 25), 300);
);

/*
 * Per block: the band's dynamics settings into its smoothing coefficients
 */
function band_dyn_block(b)
  instance (dthr, dratio, drange, datt, drel, datt2, drel2, dauto) local (a, rf, rs, k) (
  dthr = Band_Dyn_Thresh[b];
  dratio = max(Band_Dyn_Ratio[b], 1);
  drange = Band_Dynamic_Range[b];
  dauto = Band_Dyn_Auto[b];
  k = DYN_STEP / (0.001 * srate);
  dauto ? (
    // Auto: a fast release for transients, and a slower envelope that only charges on sustained
    // material and releases smoothly
    a = band_dyn_auto_attack(b);
    rf = band_dyn_auto_release(b);
    rs = min(max(40 * a, 150), 1500);
    datt = 1 - exp(-k / a);
    drel = 1 - exp(-k / rf);
    datt2 = 1 - exp(-k / max(10 * a, 50));
    drel2 = 1 - exp(-k / rs);
  ) : (
    datt = 1 - exp(-k / max(Band_Dyn_Attack[b], 0.05));
    drel = 1 - exp(-k / max(Band_Dyn_Release[b], 1));
  );
);

/*
 * The band is no longer dynamic: forget its state
 */
function band_dyn_reset()
  instance (filter, dms0, dms1, dg, dg1, dg2, dgap, dcnt, dlive, dpend) (
  dms0 = dms1 = dg = dg1 = dg2 = dgap = 0;
  dcnt = 0;
  dlive = dpend = 0;
  // The lean update leaves the glide at DYN_STEP samples: back to the normal 30ms
  filter.ivf_set_sample_rate(srate);
);

/*
 * The band is off or bypassed: forget its dynamics, and glide to nothing at the normal rate
 */
function band_off()
  instance (filter) (
  this.band_dyn_reset();
  filter.ivf_bypass();
);

/*
 * One sample of a dynamic band's detector, and every DYN_STEP samples its gain
 */
function band_dyn_tick(b, grp, src)
  instance (filter, det, dms0, dms1, dkrms, dg, dg1, dg2, dgap, dcnt, dthr, dratio, drange, datt, drel,
            datt2, drel2, dauto, dstatic_glide, dsf, dsq, dsg, dss, dtf, dtq, dtg, dts, dsmooth, dlive, dpend,
            dnorm)
  local (l, r, x, lvl, over, y, want, mv) (
  // The detector's input in the band's placement: Stereo hears the louder of left and right
  // (a silent sidechain gets the same tiny offset as the main input, and the RMS a tiny floor, so
  // neither decays into denormals)
  src > 0 ? (l = spl(2 * src) + 0.0000000001; r = spl(2 * src + 1) + 0.0000000001) : (l = spl0; r = spl1);
  grp == 0 ? (
    x = det.ivf_process0(l) * dnorm; dms0 += dkrms * (x * x - dms0) + 0.000000000000000000000000000001;
    b == Dyn_Listen ? Dyn_ListenL = x;
    x = det.ivf_process1(r) * dnorm; dms1 += dkrms * (x * x - dms1) + 0.000000000000000000000000000001;
    b == Dyn_Listen ? Dyn_ListenR = x;
  ) : (
    x = det.ivf_process0(grp == 1 ? (l + r) * 0.5 : grp == 2 ? (l - r) * 0.5 : grp == 3 ? l : r) * dnorm;
    dms0 += dkrms * (x * x - dms0) + 0.000000000000000000000000000001;
    b == Dyn_Listen ? Dyn_ListenL = Dyn_ListenR = x;
  );

  (dcnt -= 1) <= 0 ? (
    dcnt = DYN_STEP;
    // Level in dB, so a sine reads its peak level
    lvl = 10 * log10(max(grp == 0 ? max(dms0, dms1) : dms0, 0.00000000000000000001)) + 3.0103;
    Band_Dyn_Level[b] = lvl;

    // Soft knee (DYN_KNEE dB wide), then the ratio, capped by the range (its sign is the direction)
    over = lvl - dthr;
    y = over <= -DYN_KNEE * 0.5 ? 0 : over >= DYN_KNEE * 0.5 ? over : sqr(over + DYN_KNEE * 0.5) / (2 * DYN_KNEE);
    y *= 1 - 1 / dratio;
    want = drange < 0 ? -min(y, -drange) : min(y, drange);

    // Attack while the change is growing, release while it shrinks. Auto runs two envelopes, fast and
    // slow, and the larger change wins.
    dauto ? (
      dg1 += (abs(want) > abs(dg1) ? datt : drel) * (want - dg1);
      dg2 += (abs(want) > abs(dg2) ? datt2 : drel2) * (want - dg2);
      dg = abs(dg1) > abs(dg2) ? dg1 : dg2;
    ) : (
      dg += (abs(want) > abs(dg) ? datt : drel) * (want - dg);
      dg1 = dg2 = dg;
    );
    Band_Dyn_Gain[b] = dg;

    // Static settings glide towards their targets (frequency and Q on a log scale), and land when close
    mv = abs(dg - dgap) > 0.01;
    dlive && (dsf != dtf || dsq != dtq || dsg != dtg || dss != dts) ? (
      dsf *= (dtf / dsf) ^ dsmooth;
      dsq *= (dtq / dsq) ^ dsmooth;
      dsg += (dtg - dsg) * dsmooth;
      dss += (dts - dss) * dsmooth;
      abs(dtf / dsf - 1) < 0.0005 && abs(dtq / dsq - 1) < 0.0005 && abs(dtg - dsg) < 0.005 && abs(dts - dss) < 0.0005 ? (
        dsf = dtf; dsq = dtq; dsg = dtg; dss = dts;
      );
      mv = 1;
    );

    // Into the filter when it has moved. While the section is still gliding in (just made dynamic) a
    // move waits, and goes in when the glide ends.
    dstatic_glide && filter.ivf_is_resting() ? dstatic_glide = 0;
    dstatic_glide ? (mv ? dpend = 1; mv = 0) : dpend ? (mv = 1; dpend = 0);
    dlive && mv ? (
      dgap = dg;
      this.band_dyn_section(Band_Type[b], dsf, dsq, (dsg + dgap) * dss);
      filter.s1.ivf_sec_prep(1, 1, filter.n_run);
      filter.n_run = 1; filter.n_target = 1;
      filter.iter_t = 0;
      filter.iter_step = 1 / DYN_STEP;
    );
  );
);

/*
 * Convert slider % to frequency
 */
function per_to_freq(x, range) (
  MIN_FREQ * exp(FREQ_LOG_MAX * x / range);
);

/*
 * Convert frequency to slider %
 */
function freq_to_per(freq, range) (
  range * log(freq / MIN_FREQ) / FREQ_LOG_MAX;
);

/*
 * Convert a frequency slider to frequency. The sliders keep their original
 * scale, where 100 is 22.05kHz, so saved projects load unchanged; the range
 * runs on past 100 up to MAX_FREQ.
 */
function slider_to_freq(x) (
  min(MIN_FREQ * exp(SLIDER_FREQ_LOG_MAX * x / 100), MAX_FREQ);
);

/*
 * Convert frequency to a frequency slider value
 */
function freq_to_slider(freq) (
  100 * log(freq / MIN_FREQ) / SLIDER_FREQ_LOG_MAX;
);


function per_to_q(x, range) (
  MIN_Q * exp(Q_LOG_MAX * x / range);
);

/*
 * Convert frequency to slider %
 */
function q_to_per(q, range) (
  range * log(q / MIN_Q) / Q_LOG_MAX;
);


/*
 * Dynamics defaults for a band: off, -24dB threshold, 4:1, -6dB range, Auto timing, detecting its own
 * input, linked to the band
 */
function band_dyn_defaults(b) (
  Band_Dyn_On[b] = 0;
  Band_Dyn_Thresh[b] = -24;
  Band_Dyn_Ratio[b] = 4;
  Band_Dynamic_Range[b] = -6;
  Band_Dyn_Attack[b] = 5;
  Band_Dyn_Release[b] = 80;
  Band_Dyn_Auto[b] = 1;
  Band_Dyn_Source[b] = 0;
  Band_Dyn_Link[b] = 1;
  Band_Dyn_DetFreq[b] = 1000;
  // 0: the detector hasn't been placed (unlinking places it at the band)
  Band_Dyn_DetWidth[b] = 0;
  Band_Dyn_Gain[b] = 0;
  Band_Dyn_Level[b] = -150;
);

/*
 * Copy a band's dynamics settings (duplicate and split)
 */
function band_dyn_copy(b, other) (
  Band_Dyn_On[b] = Band_Dyn_On[other];
  Band_Dyn_Thresh[b] = Band_Dyn_Thresh[other];
  Band_Dyn_Ratio[b] = Band_Dyn_Ratio[other];
  Band_Dynamic_Range[b] = Band_Dynamic_Range[other];
  Band_Dyn_Attack[b] = Band_Dyn_Attack[other];
  Band_Dyn_Release[b] = Band_Dyn_Release[other];
  Band_Dyn_Auto[b] = Band_Dyn_Auto[other];
  Band_Dyn_Source[b] = Band_Dyn_Source[other];
  Band_Dyn_Link[b] = Band_Dyn_Link[other];
  Band_Dyn_DetFreq[b] = Band_Dyn_DetFreq[other];
  Band_Dyn_DetWidth[b] = Band_Dyn_DetWidth[other];
);

/*
 * Unlink a band's detection: the first time, its detector node starts at the band, as wide as a bell's
 * bandwidth (two octaves for a shelf); after that it returns to where it was
 */
function dyn_unlink(b) local (q) (
  Band_Dyn_Link[b] = 0;
  // A detector that was placed before (width set) goes back where it was
  Band_Dyn_DetWidth[b] <= 0 ? (
    Band_Dyn_DetFreq[b] = min(max(Band_Frequency[b], 20), min(20000, 0.45 * srate));
    q = max(Band_Q[b], 0.1);
    Band_Dyn_DetWidth[b] = Band_Type[b] == FILTER_PEAK ? min(max(2 / log(2) * log(1 / (2 * q) + sqrt(1 / (4 * q * q) + 1)), 0.25), 8) : 2;
  );
);

/*
 * Dynamics are for bells and shelves only
 */
function band_dyn_capable(t) (
  t == FILTER_PEAK || t == FILTER_LOW_SHELF || t == FILTER_HIGH_SHELF;
);

