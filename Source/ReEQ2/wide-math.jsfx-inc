);
function wf_in_core(kind,order,fc,q,db)(
 fc>=.000026041666666666667 && fc<=3.75 && q>=.25 && q<=30 && abs(db)<=24;
);
function wf_design(out*,bank,notch,wide,kind,order,fc,q,db) local(core_ok)(
  (kind!==3 && kind!==4 && kind!==7)?db=0;order===1?q=1;
