  kind===6 && q>=.25 && q<=30 && fc<.000026041666666666667?this.n.wf_notch_edge_lo(out,bank,fc,q):kind===6?(core_ok?(fc<.48?this.n.nl_calc(out,bank,fc,q):this.n.na_calc(out,bank,notch,fc,q);):this.wf_notch(out,bank,notch,wide,fc,q);):
  kind===2?this.wf_allpass(out,order,fc,q):
