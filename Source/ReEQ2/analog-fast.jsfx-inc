function ef_plot_packed_notch(band*) local(dl, dh, dm, nl, nh, nm, pole_dc, pole_ny) (
  dl = 0.5 * ((1 + band.a1) + band.a2);
  dh = 0.5 * ((1 - band.a1) + band.a2);
  dm = 1 - band.a2;
  nl = band.npB0 * dl + 0.5 * (band.npC0 + band.npC1);
  nh = band.npB0 * dh + 0.5 * (band.npC1 - band.npC0);
  nm = band.npB0 * dm - band.npC1;
  pole_dc = 1 + band.cp;
  pole_ny = 1 - band.cp;
  this.ef_plot_combine(dl, dh, dm, nl, nh, nm, pole_dc, pole_ny, pole_dc, pole_ny,
