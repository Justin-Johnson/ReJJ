);
function ef_plot_capture(band*, kind, use_target)
  instance(plot_ready, plot_rate, angle_per_hz)
(
  plot_rate = srate;
  plot_ready = plot_rate > 0 && kind >= 0 && kind <= 7 && kind === floor(kind)
               && (kind === 6 ? band.ready : band.cold.j9_ready);
